# Example environment variables for backend (DO NOT COMMIT secrets)
# Copy to `backend/.env` and fill real values locally.

# Database connection (Postgres example)
# DATABASE_URL=postgresql://user:password@localhost:5432/mente_ativa_db

# Path (relative to backend/) to the Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Optional explicit Firebase project id
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Web API Key (required to validate ID tokens via REST)
FIREBASE_API_KEY=your-firebase-web-api-key

FRONTEND_ORIGIN=http://localhost:5173DATABASE_URL=postgresql://usuario:senha@localhost:5432/mente_ativa
FRONTEND_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=mente-ativa-827bd
